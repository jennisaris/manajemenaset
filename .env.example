# =============================================================================
# MANAJEMEN ASET UNIVERSITAS - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file with real secrets to version control.
# =============================================================================

# Supabase (legacy - optional, can be left empty)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL Database
DATABASE_URL=postgresql://aset_user:your-password@127.0.0.1:5432/aset_universitas

# Authentication Secret (MINIMUM 24 characters, random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
SMTP_FROM="Manajemen Aset Universitas" <your-email@gmail.com>

# Optional: Disable email sending (logs to console instead)
# DISABLE_EMAIL=true

# Optional: Force secure cookies in development
# SESSION_COOKIE_SECURE=true
